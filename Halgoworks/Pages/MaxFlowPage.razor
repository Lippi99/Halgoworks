@page "/max-flow"
@using Halgoworks.Core.MaxFlow
@using Halgoworks.Components.MaxFlow
@implements IDisposable
@inject NavigationManager Nav

<SeoHead Title="@Problems.MaxFlow.SeoTitle" Description="@Problems.MaxFlow.SeoDescription" Path="@Problems.MaxFlow.Slug" Image="@Problems.MaxFlow.Slug"
         ImageAlt="@($"{Problems.MaxFlow.Name} lab in Halgoworks")" StructuredData="SeoHead.LabData(Nav, Problems.MaxFlow)" />

<div class="page">
    <LabHeader Problem="Problems.MaxFlow" />
    <ShareNotice Problem="@_shareProblem" />

    <section class="lab" aria-label="Maximum flow lab">
        <div class="toolbar">
            <div class="field">
                <span>Mode</span>
                <Segmented T="string" Options="LabModes.WithoutPlay" Value="_mode" ValueChanged="SetMode" Label="Mode" />
            </div>
            @if (_mode == LabModes.Watch)
            {
            <div class="field">
                <span>Algorithm</span>
                <Segmented T="FlowAlgorithm" Options="AlgorithmOptions" Value="_algorithm" ValueChanged="SetAlgorithm" Label="Algorithm" />
            </div>
            }
            @if (_mode != LabModes.Scale)
            {
            <label class="field">
                <span>Network</span>
                <select value="@_preset" @onchange="SetPreset">
                    @if (_preset == "shared")
                    {
                        <option value="shared">Shared example</option>
                    }
@if (_preset == "custom")
                    {
                        <option value="custom">Your edited network</option>
                    }
                    <option value="textbook">Textbook example</option>
                    <option value="water">City water supply</option>
                    <option value="random">Random layered network</option>
                </select>
            </label>
            @if (_preset == "random")
            {
                <label class="field">
                    <span>Middle layers <output>@_layers</output></span>
                    <input type="range" min="2" max="4" value="@_layers" style="--pct: @Pct(_layers, 2, 4)" @onchange="SetLayers" />
                </label>
                <button type="button" class="btn" @onclick="Reroll"><Icon Name="shuffle" />New network</button>
            }
            }
            <span class="spacer"></span>
            @if (_mode == LabModes.Watch)
            {
                <label class="check"><input type="checkbox" checked="@_editing" @onchange="SetEditing" />Edit</label>
            }
            <ShareButton Url="ShareLink" />
            @if (_mode == LabModes.Watch)
            {
            <div class="field">
                <span>Show</span>
                <Segmented T="string" Options="Views" Value="_show" ValueChanged="v => _show = v" Label="What to show" />
            </div>
            }
        </div>

        @if (_mode == LabModes.Race)
        {
            <MaxFlowRace Network="_network" Version="_version" Selected="RaceKeys" SelectedChanged="v => _raceState = string.Join(',', v)" />
        }
        else if (_mode == LabModes.Scale)
        {
            <MaxFlowScale State="@_scaleState" StateChanged="v => _scaleState = v" />
        }
        else
        {
        <div class="lab-body">
            <div class="stage">
                <div class="stage-head">
                    @if (IsPushRelabel && _show != "residual")
                    {
                        <ul class="legend">
                            <li><span class="swatch" style="background: @Palette.Ink0; border: 1px solid @Palette.Text2"></span>Badge: node height</li>
                            <li><span class="swatch" style="background: @Palette.Signal; border-radius: 50%"></span>Excess the node is holding</li>
                            <li><span class="swatch line" style="background: @Palette.Series[0]"></span>Flow</li>
                            <li><span class="swatch line" style="background: @Palette.Signal"></span>Arc being pushed</li>
                        </ul>
                    }
                    else if (_show == "residual")
                    {
                        <ul class="legend">
                            <li><span class="swatch line" style="background: @Palette.Series[0]"></span>Spare capacity (forward arc)</li>
                            <li><span class="swatch line" style="background: @Palette.Series[1]"></span>Flow that can be cancelled (backward arc)</li>
                            <li><span class="swatch line" style="background: @Palette.Signal"></span>Augmenting path</li>
                        </ul>
                    }
                    else
                    {
                        <ul class="legend">
                            <li><span class="swatch line" style="background: @Palette.Line; height: 8px"></span>Pipe width is capacity</li>
                            <li><span class="swatch line" style="background: @Palette.Series[0]"></span>Flow</li>
                            <li><span class="swatch line" style="background: @Palette.Text1"></span>Search tree</li>
                            <li><span class="swatch line" style="background: @Palette.Signal"></span>Path or arc in focus</li>
                            @if (Step.SourceSide is not null)
                            {
                                <li><span class="swatch" style="background: #1d3a63; border: 1px solid @Palette.Series[0]"></span>Source side S</li>
                                <li><span class="swatch" style="background: #3a2420; border: 1px solid @Palette.Series[1]"></span>Sink side</li>
                            }
                        </ul>
                    }
                </div>
                <div class="stage-body">
                    @if (_show == "3d" && IsPushRelabel)
                    {
                        <Scene3D Kind="flow" State="SceneState" Version="_version * 100000 + _player.Index" Label="The network in 3D: each node stands at its push–relabel height" />
                    }
                    else
                    {
                        <FlowGraph Network="_network" Step="Step" Residual="@(_show == "residual" && !_editing)" Editable="_editing"
                                   SelectedNode="_selectedNode" SelectedEdge="_selectedEdge"
                                   OnNodeMoved="MoveNode" OnNodeClick="NodeClick" OnEdgeClick="@(id => { _selectedEdge = id; _selectedNode = null; })" />
                    }
                    <div class="flow-foot">
                        <div class="frontier">
                            <span class="muted">@FrontierLabel</span>
                            @if (Step.Frontier.Count == 0)
                            {
                                <span class="muted">empty</span>
                            }
                            @foreach (var node in Step.Frontier)
                            {
                                <span class="chip">@_network.Nodes[node].Label</span>
                            }
                        </div>
                        <div class="gauge" style="min-width: 260px; flex: 1; max-width: 420px;">
                            <div class="gauge-head">
                                <span>Flow reaching @_network.Nodes[_network.Sink].Label: <strong class="num">@Step.Total</strong></span>
                                <span>maximum @_final.Total</span>
                            </div>
                            <div class="gauge-track">
                                @if (Step.Total > 0)
                                {
                                    <span class="gauge-seg" style="flex: 0 0 @Palette.F(100.0 * Step.Total / Math.Max(1, _final.Total), "0.#")%"></span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @if (_editing)
            {
                <MaxFlowEditor Network="_network" SelectedNode="_selectedNode" SelectedEdge="_selectedEdge" AddingFrom="_addingFrom"
                               AddingFromChanged="v => _addingFrom = v" Changed="Edited" ClearSelection="ClearSelection" />
            }
            else
            {
                <StepPanel Step="Step" Algorithm="MaxFlowSolver.Info(_algorithm)" Index="_player.Index" Count="_player.Count" />
            }
        </div>
        <PlaybackBar Player="_player" Marks="_marks" />
        }
    </section>

    <div class="results">
        <section class="panel" aria-labelledby="mf-paths">
            <h2 class="panel-title" id="mf-paths">@(IsPushRelabel ? "Pushes, in order" : "Augmenting paths, in order")</h2>
            <p class="panel-sub">@(IsPushRelabel ? "Each row moves excess one arc downhill. Push–relabel never builds a whole path from s to t." : "Each row is one push. The bottleneck is the smallest spare capacity along the path.")</p>
            <div class="panel-body">
                <table class="data-table">
                    <thead>
                        <tr><th>#</th><th>@(IsPushRelabel ? "Arc" : "Path")</th><th class="r">@(IsPushRelabel ? "Amount" : "Bottleneck")</th><th class="r">@(IsPushRelabel ? "At sink after" : "Total after")</th></tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _augments.Count; i++)
                        {
                            var a = _augments[i];
                            <tr class="@(a.Step == _player.Index || (!IsPushRelabel && a.Step - 1 == _player.Index) ? "on" : null)">
                                <td class="muted">@(i + 1)</td>
                                <td>@a.Path</td>
                                <td class="r">@a.Pushed</td>
                                <td class="r">@a.Total</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
        <section class="panel" aria-labelledby="mf-compare">
            <h2 class="panel-title" id="mf-compare">Augmenting paths each algorithm needs</h2>
            <p class="panel-sub">The three path-based algorithms reach the same maximum flow of @_final.Total, but differ in how many paths they push along. Push–relabel gets there with @_prSummary instead.</p>
            <div class="panel-body">
                <BarChart Data="_compare" AriaLabel="Augmenting paths per algorithm" Min="0" />
            </div>
        </section>
    </div>

    <MaxFlowArticle />
</div>

@code {
    private static readonly IReadOnlyList<SegOption<FlowAlgorithm>> AlgorithmOptions =
    [
        new(FlowAlgorithm.EdmondsKarp, "Edmonds–Karp"),
        new(FlowAlgorithm.FordFulkerson, "Ford–Fulkerson"),
        new(FlowAlgorithm.Dinic, "Dinic"),
        new(FlowAlgorithm.PushRelabel, "Push–relabel"),
    ];

    private static readonly FlowAlgorithm[] PathAlgorithms = [FlowAlgorithm.EdmondsKarp, FlowAlgorithm.FordFulkerson, FlowAlgorithm.Dinic];

    private IReadOnlyList<SegOption<string>> Views =>
    [
        new("flow", "Flow"),
        new("residual", "Residual graph"),
        new("3d", "3D heights", !IsPushRelabel, IsPushRelabel ? null : "Heights only exist in push–relabel"),
    ];

    private bool IsPushRelabel => _algorithm == FlowAlgorithm.PushRelabel;

    private sealed record Augment(int Step, string Path, int Pushed, int Total);

    private readonly Player _player = new();
    private FlowAlgorithm _algorithm = FlowAlgorithm.EdmondsKarp;
    private string _preset = "textbook";
    private int _layers = 2;
    private int _seed = 4;
    private string _show = "flow";
    private int _version;
    private string _prSummary = "";

    private FlowNetwork _network = FlowNetworks.Textbook();
    private IReadOnlyList<MaxFlowStep> _steps = [];
    private IReadOnlyList<int> _marks = [];
    private IReadOnlyList<Augment> _augments = [];
    private IReadOnlyList<BarDatum> _compare = [];

    private MaxFlowStep Step => _steps[Math.Min(_player.Index, _steps.Count - 1)];
    private MaxFlowStep _final => _steps[^1];

    private string FrontierLabel => _algorithm switch
    {
        FlowAlgorithm.FordFulkerson => "DFS stack, top first:",
        FlowAlgorithm.Dinic => "Nodes waiting:",
        FlowAlgorithm.PushRelabel => "Active nodes, in queue order:",
        _ => "BFS queue:",
    };

    [SupplyParameterFromQuery(Name = "i")] public string? SharedInstance { get; set; }
    [SupplyParameterFromQuery(Name = "a")] public string? SharedAlgorithm { get; set; }
    [SupplyParameterFromQuery(Name = "s")] public int? SharedStep { get; set; }
    [SupplyParameterFromQuery(Name = "v")] public string? SharedView { get; set; }
    [SupplyParameterFromQuery(Name = "m")] public string? SharedMode { get; set; }
    [SupplyParameterFromQuery(Name = "p")] public string? SharedModeState { get; set; }

    private string _mode = LabModes.Watch;
    private string? _raceState;
    private string? _scaleState;

    private IReadOnlyList<string>? RaceKeys => _raceState?.Split(',', StringSplitOptions.RemoveEmptyEntries);

    // Whatever the current mode keeps in share links: racers in Race, size and seed in Scale.
    private string? ModeState()
    {
        var state = _mode switch
        {
            LabModes.Race => _raceState,
            LabModes.Scale => _scaleState,
            _ => null,
        };
        return string.IsNullOrEmpty(state) ? null : state;
    }

    private void SetMode(string mode)
    {
        _mode = mode;
        _editing = false;
        _player.Pause();
    }
    private string? _shareProblem;

    protected override void OnInitialized()
    {
        _player.Changed += OnPlayerChanged;
        _mode = LabModes.Parse(SharedMode, play: false);
        _raceState = _mode == LabModes.Race ? SharedModeState : null;
        _scaleState = _mode == LabModes.Scale ? SharedModeState : null;
        if (SharedInstance is not null && ShareState.Decode<FlowNetwork>(SharedInstance, InstanceChecks.Check, out _shareProblem) is { } shared)
        {
            _network = shared;
            _preset = "shared";
        }

        if (Enum.TryParse<FlowAlgorithm>(SharedAlgorithm, out var algorithm) && Enum.IsDefined(algorithm)) _algorithm = algorithm;
        _show = SharedView is "residual" or "3d" ? SharedView : "flow";
        if (_show == "3d" && !IsPushRelabel) _show = "flow";
        Rebuild(newNetwork: true);
        if (SharedStep is { } step) _player.Seek(step);
    }

    private void OnPlayerChanged() => InvokeAsync(StateHasChanged);

    private string ShareLink() => ShareState.Link(Nav, "max-flow",
        ("i", ShareState.Encode(_network)), ("a", _algorithm.ToString()), ("s", _player.Index.ToString(CultureInfo.InvariantCulture)), ("v", _show == "flow" ? null : _show),
        ("m", _mode == LabModes.Watch ? null : _mode), ("p", ModeState()));

    private void Rebuild(bool newNetwork)
    {
        if (newNetwork)
        {
            _network = _preset switch
            {
                "shared" or "custom" => _network,
                "water" => FlowNetworks.WaterSupply(),
                "random" => FlowNetworks.Random(_layers, _seed),
                _ => FlowNetworks.Textbook(),
            };
            _compare = PathAlgorithms.Select(a =>
            {
                var last = MaxFlowSolver.Trace(_network, a)[^1];
                return new BarDatum(AlgorithmOptions.First(o => o.Value == a).Text, last.Augmentations, $"{last.Augmentations}", false);
            }).ToList();
            var pr = MaxFlowSolver.Trace(_network, FlowAlgorithm.PushRelabel);
            var pushes = pr.Count(x => x.Pushed is not null);
            var relabels = pr.Count(x => x.Title.StartsWith("Relabel", StringComparison.Ordinal));
            _prSummary = $"{pushes} pushes and {relabels} relabels";
        }

        _compare = _compare.Select((d, i) => d with { Highlight = PathAlgorithms[i] == _algorithm }).ToList();
        _version++;
        _steps = MaxFlowSolver.Trace(_network, _algorithm);
        _marks = Enumerable.Range(1, _steps.Count - 1).Where(i => _steps[i].Phase != _steps[i - 1].Phase).ToList();
        _augments = _steps
            .Select((s, i) => (s, i))
            .Where(x => x.s.Pushed is not null)
            .Select(x => new Augment(x.i, IsPushRelabel ? ArcLabel(x.s.Scanned[0]) : PathName(x.s.Path), x.s.Pushed!.Value, x.s.Total))
            .ToList();
        _player.Load(_steps.Count);
    }

    private object SceneState()
    {
        var step = Step;
        return new
        {
            nodes = _network.Nodes.Select(n => new
            {
                id = n.Id,
                label = n.Label,
                x = n.X,
                y = n.Y,
                height = step.Height?[n.Id] ?? 0,
                excess = n.Id == _network.Source || n.Id == _network.Sink ? 0 : step.Excess?[n.Id] ?? 0,
                terminal = n.Id == _network.Source || n.Id == _network.Sink,
                current = step.Nodes.Count > n.Id && step.Nodes[n.Id] == NodeState.Current,
            }),
            edges = _network.Edges.Select(e => new { from = e.From, to = e.To, capacity = e.Capacity, flow = step.Flow[e.Id] }),
            pushed = step.Scanned.Select(a => new[]
            {
                a.Forward ? _network.Edges[a.Edge].From : _network.Edges[a.Edge].To,
                a.Forward ? _network.Edges[a.Edge].To : _network.Edges[a.Edge].From,
            }),
            maxHeight = _steps.Max(x => x.Height?.Max() ?? 0),
            atSink = step.Total,
        };
    }

    private string ArcLabel(Arc a)
    {
        var e = _network.Edges[a.Edge];
        var (from, to) = a.Forward ? (e.From, e.To) : (e.To, e.From);
        return $"{_network.Nodes[from].Label} → {_network.Nodes[to].Label}{(a.Forward ? "" : " (cancels flow)")}";
    }

    private string PathName(IReadOnlyList<Arc> path)
    {
        string Head(Arc a) => _network.Nodes[a.Forward ? _network.Edges[a.Edge].To : _network.Edges[a.Edge].From].Label;
        return string.Join(" → ", path.Select(Head).Prepend(_network.Nodes[_network.Source].Label));
    }

    private bool _editing;
    private int? _selectedNode;
    private int? _selectedEdge;
    private int? _addingFrom;

    private void SetEditing(ChangeEventArgs e)
    {
        _editing = e.Value is true;
        if (_editing && _show == "3d") _show = "flow";
        ClearSelection();
    }

    private void ClearSelection()
    {
        _selectedNode = null;
        _selectedEdge = null;
        _addingFrom = null;
    }

    // Edits become a custom network; the trace jumps to the end so the new result is visible at once.
    private void Edited(FlowNetwork network)
    {
        if (InstanceChecks.Check(network) is not null) return;
        _network = network with { Name = "Your edited network" };
        _preset = "custom";
        Rebuild(newNetwork: true);
        _player.Last();
    }

    private void MoveNode((int Node, double X, double Y) move) =>
        Edited(_network with { Nodes = _network.Nodes.Select(n => n.Id == move.Node ? n with { X = move.X, Y = move.Y } : n).ToList() });

    private void NodeClick(int node)
    {
        if (_addingFrom is not { } from)
        {
            _selectedNode = node;
            _selectedEdge = null;
            return;
        }

        if (from < 0)
        {
            _addingFrom = node;
            return;
        }

        _addingFrom = null;
        if (from == node || _network.Edges.Any(e => e.From == from && e.To == node)) return;
        _selectedEdge = _network.Edges.Count;
        _selectedNode = null;
        Edited(_network with { Edges = [.. _network.Edges, new FlowEdge(_network.Edges.Count, from, node, 5)] });
    }

    private void SetAlgorithm(FlowAlgorithm algorithm)
    {
        _algorithm = algorithm;
        if (_show == "3d" && !IsPushRelabel) _show = "flow";
        Rebuild(newNetwork: false);
    }

    private void SetPreset(ChangeEventArgs e)
    {
        _preset = e.Value?.ToString() ?? "textbook";
        Rebuild(newNetwork: true);
    }

    private void SetLayers(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var layers)) return;
        _layers = layers;
        Rebuild(newNetwork: true);
    }

    private void Reroll()
    {
        _seed = Random.Shared.Next(1, 100_000);
        Rebuild(newNetwork: true);
    }

    private static string Pct(int value, int min, int max) => Palette.F(100.0 * (value - min) / (max - min), "0.#") + "%";

    public void Dispose()
    {
        _player.Changed -= OnPlayerChanged;
        _player.Dispose();
    }
}
