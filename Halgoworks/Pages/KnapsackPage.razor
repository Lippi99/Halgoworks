@using Halgoworks.Core.Ip
@page "/knapsack"
@using Halgoworks.Core.Knapsack
@using Halgoworks.Components.Knapsack
@implements IDisposable
@inject NavigationManager Nav

<SeoHead Title="@Problems.Knapsack.SeoTitle" Description="@Problems.Knapsack.SeoDescription" Path="@Problems.Knapsack.Slug" Image="@Problems.Knapsack.Slug"
         ImageAlt="@($"{Problems.Knapsack.Name} lab in Halgoworks")" StructuredData="SeoHead.LabData(Nav, Problems.Knapsack)" />

<div class="page">
    <LabHeader Problem="Problems.Knapsack" />
    <ShareNotice Problem="@_shareProblem" />

    <section class="lab" aria-label="Knapsack lab">
        <div class="toolbar">
            <div class="field">
                <span>Mode</span>
                <Segmented T="string" Options="LabModes.WithPlay" Value="_mode" ValueChanged="SetMode" Label="Mode" />
            </div>
            @if (_mode == LabModes.Watch)
            {
                <div class="field">
                    <span>Algorithm</span>
                    <Segmented T="string" Options="Algorithms" Value="_algorithm" ValueChanged="SetAlgorithm" Label="Algorithm" />
                </div>
            }
            @if (_mode != LabModes.Scale)
            {
            <label class="field">
                <span>Example</span>
                <select value="@_preset" @onchange="SetPreset">
                    @if (_preset == "shared")
                    {
                        <option value="shared">Shared example</option>
                    }
                    @if (_preset == "custom")
                    {
                        <option value="custom">Your edited example</option>
                    }
                    <option value="camping">Camping trip</option>
                    <option value="trap">Greedy trap</option>
                    <option value="random">Random items</option>
                </select>
            </label>
            @if (_preset == "random")
            {
                <label class="field">
                    <span>Items <output>@_count</output></span>
                    <input type="range" min="3" max="10" value="@_count" style="--pct: @Pct(_count, 3, 10)" @onchange="e => SetNumber(e, v => _count = v)" />
                </label>
                <label class="field">
                    <span>Capacity <output>@_capacity kg</output></span>
                    <input type="range" min="5" max="25" value="@_capacity" style="--pct: @Pct(_capacity, 5, 25)" @onchange="e => SetNumber(e, v => _capacity = v)" />
                </label>
                <button type="button" class="btn" @onclick="Reroll"><Icon Name="shuffle" />New items</button>
            }
            }
            <span class="spacer"></span>
            @if (_mode == LabModes.Watch)
            {
                <label class="check"><input type="checkbox" checked="@_editing" @onchange="e => _editing = e.Value is true" />Edit</label>
            }
            <ShareButton Url="ShareLink" />
            @if (_mode == LabModes.Watch)
            {
                <div class="field">
                    <span>View</span>
                    <Segmented T="bool" Options="Views" Value="_view3d" ValueChanged="v => _view3d = v" Label="View" />
                </div>
            }
        </div>

        @if (_mode == LabModes.Race)
        {
            <KnapsackRace Instance="_instance" Version="_version" Selected="RaceKeys" SelectedChanged="v => _raceState = string.Join(',', v)" />
        }
        else if (_mode == LabModes.Scale)
        {
            <KnapsackScale State="@_scaleState" StateChanged="v => _scaleState = v" />
        }
        else if (_mode == LabModes.Play)
        {
            <div class="lab-body">
                <KnapsackPlay Instance="_instance" State="@_playState" StateChanged="v => _playState = v" />
            </div>
        }
        else
        {
        <div class="lab-body">
            <div class="stage">
                <div class="stage-head">
                    @if (IsDp)
                    {
                        <ul class="legend">
                            <li><span class="swatch" style="background: linear-gradient(90deg, @Palette.Ramp[1], @Palette.Ramp[^1])"></span>Best value for that capacity (brighter is higher)</li>
                            <li><span class="swatch ring"></span>Cell being decided</li>
                        </ul>
                    }
                    else if (IsIp)
                    {
                        <ul class="legend">
                            <li><span style="color: @Palette.Signal; font-weight: 700">0.6</span>Fractional value in the relaxation</li>
                            <li><span class="swatch line" style="background: @Palette.Series[0]"></span>Branch x = 1</li>
                            <li><span class="swatch line" style="background: @Palette.Text3"></span>Branch x = 0</li>
                            <li><span class="swatch" style="background: @Palette.Good"></span>Best whole solution</li>
                            <li><span class="swatch ring"></span>Node being solved</li>
                        </ul>
                    }
                    else if (IsBnb)
                    {
                        <ul class="legend">
                            <li><span class="swatch line" style="background: @Palette.Series[0]"></span>Take the item</li>
                            <li><span class="swatch line" style="background: @Palette.Text3"></span>Skip it</li>
                            <li><span class="swatch" style="background: @Palette.Good"></span>Best packing so far</li>
                            <li><span class="swatch" style="border: 1px dashed @Palette.Text3"></span>Cut: can't win</li>
                            <li><span style="color: @Palette.BadText; font-weight: 700">✗</span>Cut: too heavy</li>
                            <li><span class="swatch ring"></span>Node being examined</li>
                        </ul>
                    }
                    else
                    {
                        <ul class="legend">
                            <li><span class="swatch" style="background: @Palette.Series[0]"></span>Packed</li>
                            <li><span class="swatch" style="background: @Palette.Muted"></span>Not packed (yet)</li>
                            <li><span class="swatch ring"></span>Being decided</li>
                        </ul>
                    }
                </div>
                <div class="stage-body">
                    @if (IsDp && _view3d)
                    {
                        <Scene3D Kind="knapsack" State="SceneState" Version="_version * 100000 + _player.Index" Label="The dynamic programming table as a 3D skyline" />
                    }
                    else if (IsDp)
                    {
                        @if (Step is { SkipValue: { } skip, TakeValue: { } take, Cell: { } cell })
                        {
                            var item = _instance.Items[cell.Row - 1];
                            <div class="decision" aria-label="Decision for this cell">
                                <div class="@(Step.Took == true ? null : "win")">Skip <strong>@skip</strong><span class="muted">cell above</span></div>
                                <div class="@(Step.Took == true ? "win" : null)">Take <strong>@take</strong><span class="muted">@item.Value + best for capacity @(cell.Col - item.Weight)</span></div>
                            </div>
                        }
                        else
                        {
                            <div class="decision placeholder" aria-hidden="true"><div>Skip <strong>0</strong></div></div>
                        }
                        <KnapsackTable Instance="_instance" Step="Step" MaxValue="_maxValue" />
                        <KnapsackItems Instance="_instance" Step="Step" />
                    }
                    else if (IsIp)
                    {
                        <IpView Model="_ipModel!" Step="IpCurrent" Layout="_ipSteps[^1].Tree" Knapsack="_instance" />
                    }
                    else if (IsBnb)
                    {
                        <p class="tree-stats">
                            Nodes explored: <strong class="num">@Step.Tree.Count</strong> of @(((1L << (_instance.Items.Count + 1)) - 1).ToString("#,0", CultureInfo.InvariantCulture)) in the full decision tree.
                            Each level decides one item, densest first.
                        </p>
                        <SearchTreeView Tree="Step.Tree" Layout="_steps[^1].Tree" FocusNode="Step.FocusNode" BestNode="Step.BestNode" />
                        <KnapsackItems Instance="_instance" Step="Step" ShowDensity="true" />
                    }
                    else
                    {
                        <KnapsackItems Instance="_instance" Step="Step" ShowDensity="true" />
                        <DensityList Instance="_instance" Step="Step" />
                    }
                </div>
            </div>
            @if (_editing)
            {
                <KnapsackEditor Instance="_instance" Changed="Edited" />
            }
            else
            {
                <StepPanel Step="Current" Algorithm="Info" Index="_player.Index" Count="_player.Count" />
            }
        </div>
        <PlaybackBar Player="_player" Marks="_marks" />
        }
    </section>

    <div class="results">
        <section class="panel" aria-labelledby="kn-compare">
            <h2 class="panel-title" id="kn-compare">Exact versus greedy on these items</h2>
            <p class="panel-sub">Total value packed by each approach. Greedy rules are fast but can miss; dynamic programming and branch and bound always find the best.</p>
            <div class="panel-body">
                <BarChart Data="_compare" AriaLabel="Value packed by each approach" />
            </div>
        </section>
        <section class="panel" aria-labelledby="kn-numbers">
            <h2 class="panel-title" id="kn-numbers">This example in numbers</h2>
            <p class="panel-sub">@_instance.Name: @_instance.Items.Count items, capacity @_instance.Capacity kg.</p>
            <div class="panel-body">
                <dl class="figures">
                    <div><dt>Best value</dt><dd>@_optimum.Value</dd></div>
                    <div><dt>Weight used</dt><dd>@_optimum.Weight<small>of @_instance.Capacity kg</small></dd></div>
                    <div><dt>Table cells</dt><dd>@((_instance.Items.Count + 1) * (_instance.Capacity + 1))</dd></div>
                    <div><dt>Possible subsets</dt><dd>@(1 << _instance.Items.Count)</dd></div>
                </dl>
            </div>
        </section>
    </div>

    <KnapsackArticle Instance="_instance" Version="_version" />
</div>

@code {
    private static readonly IReadOnlyList<SegOption<string>> Algorithms =
    [
        new("dp", "Dynamic programming"),
        new("bnb", "Branch and bound"),
        new("ip", "Integer program"),
        new("greedy", "Greedy"),
    ];

    private IReadOnlyList<SegOption<bool>> Views =>
    [
        new(false, "2D"),
        new(true, "3D", !IsDp, IsDp ? null : "The 3D view shows the dynamic programming table"),
    ];

    private readonly Player _player = new();
    private string _algorithm = "dp";
    private string _preset = "camping";
    private int _count = 7;
    private int _capacity = 15;
    private int _seed = 7;
    private bool _view3d;
    private int _version;

    private KnapsackInstance _instance = KnapsackInstances.Camping();
    private IReadOnlyList<KnapsackStep> _steps = [];
    private IReadOnlyList<int> _marks = [];
    private IReadOnlyList<BarDatum> _compare = [];
    private KnapsackResult _optimum = new(0, 0, []);
    private int _maxValue;

    private bool IsDp => _algorithm == "dp";
    private static readonly KnapsackStep Empty = new();
    private KnapsackStep Step => _steps.Count == 0 ? Empty : _steps[Math.Min(_player.Index, _steps.Count - 1)];
    private IpModel? _ipModel;
    private IReadOnlyList<IpStep> _ipSteps = [];
    private bool IsIp => _algorithm == "ip";
    private IpStep IpCurrent => _ipSteps[Math.Min(_player.Index, _ipSteps.Count - 1)];
    private Halgoworks.Core.Step Current => IsIp ? IpCurrent : Step;
    private bool IsBnb => _algorithm == "bnb";
    private AlgorithmInfo Info => _algorithm switch
    {
        "bnb" => KnapsackBranchAndBound.Info,
        "ip" => IntegerProgram.Info,
        "greedy" => KnapsackSolver.Greedy,
        _ => KnapsackSolver.DynamicProgramming,
    };

    [SupplyParameterFromQuery(Name = "i")] public string? SharedInstance { get; set; }
    [SupplyParameterFromQuery(Name = "a")] public string? SharedAlgorithm { get; set; }
    [SupplyParameterFromQuery(Name = "s")] public int? SharedStep { get; set; }
    [SupplyParameterFromQuery(Name = "v")] public string? SharedView { get; set; }
    [SupplyParameterFromQuery(Name = "m")] public string? SharedMode { get; set; }
    [SupplyParameterFromQuery(Name = "p")] public string? SharedPlay { get; set; }

    private string _mode = LabModes.Watch;
    private string? _playState;
    private string? _raceState;
    private string? _scaleState;

    private IReadOnlyList<string>? RaceKeys => _raceState?.Split(',', StringSplitOptions.RemoveEmptyEntries);

    // Whatever the current mode keeps in share links: moves in Play, racers in Race, size and seed in Scale.
    private string? ModeState()
    {
        var state = _mode switch
        {
            LabModes.Play => _playState,
            LabModes.Race => _raceState,
            LabModes.Scale => _scaleState,
            _ => null,
        };
        return string.IsNullOrEmpty(state) ? null : state;
    }
    private bool _editing;
    private string? _shareProblem;

    protected override void OnInitialized()
    {
        _player.Changed += OnPlayerChanged;
        if (SharedInstance is not null && ShareState.Decode<KnapsackInstance>(SharedInstance, InstanceChecks.Check, out _shareProblem) is { } shared)
        {
            _instance = shared;
            _preset = "shared";
        }

        if (SharedAlgorithm is "dp" or "bnb" or "greedy" or "ip") _algorithm = SharedAlgorithm;
        _view3d = SharedView == "3d" && IsDp;
        _mode = LabModes.Parse(SharedMode);
        _playState = _mode == LabModes.Play ? SharedPlay : null;
        _raceState = _mode == LabModes.Race ? SharedPlay : null;
        _scaleState = _mode == LabModes.Scale ? SharedPlay : null;
        Rebuild(newInstance: true);
        if (SharedStep is { } step) _player.Seek(step);
    }

    private void OnPlayerChanged() => InvokeAsync(StateHasChanged);

    private string ShareLink() => ShareState.Link(Nav, "knapsack",
        ("i", ShareState.Encode(_instance)), ("a", _algorithm), ("s", _player.Index.ToString(CultureInfo.InvariantCulture)), ("v", _view3d ? "3d" : null),
        ("m", _mode == LabModes.Watch ? null : _mode), ("p", ModeState()));

    private void SetMode(string mode)
    {
        _mode = mode;
        _editing = false;
        _player.Pause();
    }

    // Edits become a custom example; the trace jumps to the end so the new result is visible at once.
    private void Edited(KnapsackInstance instance)
    {
        _instance = instance with { Name = "Your edited example" };
        _preset = "custom";
        Rebuild(newInstance: true);
        _player.Last();
    }

    private void Rebuild(bool newInstance)
    {
        if (newInstance)
        {
            _instance = _preset switch
            {
                "shared" or "custom" => _instance,
                "trap" => KnapsackInstances.GreedyTrap(),
                "random" => KnapsackInstances.Random(_count, _capacity, _seed),
                _ => KnapsackInstances.Camping(),
            };
            _optimum = KnapsackSolver.Solve(_instance);
        }

        IReadOnlyList<Halgoworks.Core.Step> active;
        if (IsIp)
        {
            _ipModel = IntegerProgram.Knapsack(_instance);
            _ipSteps = IntegerProgram.Trace(_ipModel, j => $"x{IntegerProgram.Sub(j + 1)} ({_instance.Items[j].Name.ToLowerInvariant()})");
            active = _ipSteps;
        }
        else
        {
            _steps = KnapsackSolver.Trace(_instance, _algorithm);
            active = _steps;
        }

        _marks = Enumerable.Range(1, active.Count - 1).Where(i => active[i].Phase != active[i - 1].Phase).ToList();
        _maxValue = _optimum.Value;
        _compare =
        [
            new("Dynamic programming", _optimum.Value, $"{_optimum.Value}", IsDp, "Optimal"),
            new("Branch and bound", _optimum.Value, $"{_optimum.Value}", IsBnb, "Optimal, proven by search"),
            Greedy("Greedy by value per kg", GreedyOrder.Density, _algorithm == "greedy"),
            Greedy("Greedy by value", GreedyOrder.Value, false),
            Greedy("Greedy by lightest", GreedyOrder.Lightest, false),
        ];
        _version++;
        _player.Load(active.Count);
    }

    private BarDatum Greedy(string label, GreedyOrder order, bool highlight)
    {
        var result = KnapsackSolver.SolveGreedy(_instance, order);
        var gap = _optimum.Value - result.Value;
        return new BarDatum(label, result.Value, $"{result.Value}", highlight, gap == 0 ? "Matches the optimum here" : $"{gap} below the optimum");
    }

    private void SetAlgorithm(string algorithm)
    {
        _algorithm = algorithm;
        if (!IsDp) _view3d = false;
        Rebuild(newInstance: false);
    }

    private void SetPreset(ChangeEventArgs e)
    {
        _preset = e.Value?.ToString() ?? "camping";
        Rebuild(newInstance: true);
    }

    private void SetNumber(ChangeEventArgs e, Action<int> set)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value)) return;
        set(value);
        Rebuild(newInstance: true);
    }

    private void Reroll()
    {
        _seed = Random.Shared.Next(1, 100_000);
        Rebuild(newInstance: true);
    }

    private static string Pct(int value, int min, int max) => Palette.F(100.0 * (value - min) / (max - min), "0.#") + "%";

    private object SceneState()
    {
        var step = Step;
        static int[]? Cell(GridCell? c) => c is { } x ? [x.Row, x.Col] : null;
        return new
        {
            table = step.Table,
            max = _maxValue,
            cell = Cell(step.Cell),
            skip = Cell(step.SkipFrom),
            take = Cell(step.TakeFrom),
            took = step.Took == true,
            batch = step.Batch.Select(b => new[] { b.Row, b.Col }),
            path = step.Path.Select(p => new[] { p.Row, p.Col }),
            rows = _instance.Items.Select(i => $"{i.Icon} {i.Name}").Prepend("No items"),
        };
    }

    public void Dispose()
    {
        _player.Changed -= OnPlayerChanged;
        _player.Dispose();
    }
}
