@page "/matching"
@using Halgoworks.Core.Matching
@using Halgoworks.Core.MaxFlow
@using Halgoworks.Components.Matching
@using Halgoworks.Components.MaxFlow
@implements IDisposable
@inject NavigationManager Nav

<SeoHead Title="@Problems.Matching.SeoTitle" Description="@Problems.Matching.SeoDescription" Path="@Problems.Matching.Slug" Image="@Problems.Matching.Slug"
         ImageAlt="@($"{Problems.Matching.Name} lab in Halgoworks")" StructuredData="SeoHead.LabData(Nav, Problems.Matching)" />

<div class="page">
    <LabHeader Problem="Problems.Matching" />
    <ShareNotice Problem="@_shareProblem" />

    <section class="lab" aria-label="Bipartite matching lab">
        <div class="toolbar">
            <div class="field">
                <span>Mode</span>
                <Segmented T="string" Options="LabModes.WithoutPlay" Value="_mode" ValueChanged="SetMode" Label="Mode" />
            </div>
            @if (_mode == LabModes.Watch)
            {
            <div class="field">
                <span>Algorithm</span>
                <Segmented T="FlowAlgorithm" Options="AlgorithmOptions" Value="_algorithm" ValueChanged="SetAlgorithm" Label="Algorithm" />
            </div>
            }
            @if (_mode != LabModes.Scale)
            {
            <label class="field">
                <span>Example</span>
                <select value="@_preset" @onchange="SetPreset">
                    @if (_preset == "shared")
                    {
                        <option value="shared">Shared example</option>
                    }
@if (_preset == "custom")
                    {
                        <option value="custom">Your edited example</option>
                    }
                    <option value="developers">Developers and tickets</option>
                    <option value="trap">Greedy trap</option>
                    <option value="random">Random</option>
                </select>
            </label>
            @if (_preset == "random")
            {
                <label class="field">
                    <span>Workers <output>@_left</output></span>
                    <input type="range" min="3" max="9" value="@_left" style="--pct: @Pct(_left, 3, 9)" @onchange="e => SetNumber(e, v => _left = v)" />
                </label>
                <label class="field">
                    <span>Tasks <output>@_right</output></span>
                    <input type="range" min="3" max="9" value="@_right" style="--pct: @Pct(_right, 3, 9)" @onchange="e => SetNumber(e, v => _right = v)" />
                </label>
                <label class="field">
                    <span>Allowed pairs <output>@(_density)%</output></span>
                    <input type="range" min="15" max="70" step="5" value="@_density" style="--pct: @Pct(_density, 15, 70)" @onchange="e => SetNumber(e, v => _density = v)" />
                </label>
                <button type="button" class="btn" @onclick="Reroll"><Icon Name="shuffle" />New example</button>
            }
            }
            <span class="spacer"></span>
            @if (_mode == LabModes.Watch)
            {
                <label class="check"><input type="checkbox" checked="@_editing" @onchange="SetEditing" />Edit</label>
            }
            <ShareButton Url="ShareLink" />
            @if (_mode == LabModes.Watch)
            {
            <div class="field">
                <span>Show</span>
                <Segmented T="bool" Options="Views" Value="_flow" ValueChanged="v => _flow = v" Label="What to show" />
            </div>
            }
        </div>

        @if (_mode == LabModes.Race)
        {
            <MatchingRace Instance="_instance" Version="_version" Selected="RaceKeys" SelectedChanged="v => _raceState = string.Join(',', v)" />
        }
        else if (_mode == LabModes.Scale)
        {
            <MatchingScale State="@_scaleState" StateChanged="v => _scaleState = v" />
        }
        else
        {
        <div class="lab-body">
            <div class="stage">
                <div class="stage-head">
                    @if (_flow)
                    {
                        <ul class="legend">
                            <li><span class="swatch line" style="background: @Palette.Series[0]"></span>Flow (one unit = one matched pair)</li>
                            <li><span class="swatch line" style="background: @Palette.Text1"></span>Search tree</li>
                            <li><span class="swatch line" style="background: @Palette.Signal"></span>Augmenting path</li>
                        </ul>
                    }
                    else
                    {
                        <ul class="legend">
                            <li><span class="swatch line" style="background: @Palette.Line"></span>Allowed pair</li>
                            <li><span class="swatch line" style="background: @Palette.Series[0]; height: 4px"></span>Matched</li>
                            <li><span class="swatch line" style="background: @Palette.Signal; height: 4px"></span>Added by the augmenting path</li>
                            <li><span class="swatch line" style="background: @Palette.BadText"></span>Undone to make room</li>
                            <li><span class="swatch ring"></span>Being explored</li>
                        </ul>
                    }
                </div>
                <div class="stage-body">
                    @if (_flow)
                    {
                        <FlowGraph Network="_network" Step="Step.Flow" />
                    }
                    else
                    {
                        <BipartiteView Instance="_instance" Step="Step" Editable="_editing" Selected="_selected" OnNodeClick="NodeClick" />
                    }
                    <div class="match-chips" aria-label="Matched pairs">
                        <span class="muted">Matched (@Step.Matched.Count):</span>
                        @if (Step.Matched.Count == 0)
                        {
                            <span class="muted">nobody yet</span>
                        }
                        @foreach (var i in Step.Matched)
                        {
                            var p = _instance.Pairs[i];
                            <span class="chip">@_instance.Left[p.Left] – @_instance.Right[p.Right]</span>
                        }
                    </div>
                </div>
            </div>
            @if (_editing)
            {
                <MatchingEditor Instance="_instance" Selected="_selected" Changed="Edited" ClearSelection="() => _selected = null" />
            }
            else
            {
                <StepPanel Step="Step" Algorithm="MatchingSolver.Info(_algorithm)" Index="_player.Index" Count="_player.Count" />
            }
        </div>
        <PlaybackBar Player="_player" Marks="_marks" />
        }
    </section>

    <div class="results">
        <section class="panel" aria-labelledby="mt-compare">
            <h2 class="panel-title" id="mt-compare">Greedy versus maximum</h2>
            <p class="panel-sub">Greedy takes allowed pairs in order whenever both sides are free, and never reconsiders. Augmenting paths can reroute earlier choices.</p>
            <div class="panel-body">
                <BarChart Data="_compare" Refs="_refs" AriaLabel="Pairs matched by greedy and by max flow" Min="0" />
            </div>
        </section>
        <section class="panel" aria-labelledby="mt-numbers">
            <h2 class="panel-title" id="mt-numbers">This example in numbers</h2>
            <p class="panel-sub">@_instance.Name: @_instance.Left.Count @_instance.LeftTitle.ToLowerInvariant(), @_instance.Right.Count @_instance.RightTitle.ToLowerInvariant(), @_instance.Pairs.Count allowed pairs.</p>
            <div class="panel-body">
                <dl class="figures">
                    <div><dt>Maximum matching</dt><dd>@_final.Matched.Count<small>pairs</small></dd></div>
                    <div><dt>Greedy</dt><dd>@_greedy<small>pairs</small></dd></div>
                    <div><dt>Perfect?</dt><dd>@(_final.Matched.Count == Math.Min(_instance.Left.Count, _instance.Right.Count) ? "Yes" : "No")</dd></div>
                    <div><dt>Flow network</dt><dd>@_network.Nodes.Count<small>nodes, @_network.Edges.Count edges</small></dd></div>
                </dl>
            </div>
        </section>
    </div>

    <MatchingArticle />
</div>

@code {
    private static readonly IReadOnlyList<SegOption<FlowAlgorithm>> AlgorithmOptions =
    [
        new(FlowAlgorithm.EdmondsKarp, "Edmonds–Karp"),
        new(FlowAlgorithm.FordFulkerson, "Ford–Fulkerson"),
        new(FlowAlgorithm.Dinic, "Dinic"),
    ];

    private static readonly IReadOnlyList<SegOption<bool>> Views = [new(false, "Matching"), new(true, "Flow network")];

    private readonly Player _player = new();
    private FlowAlgorithm _algorithm = FlowAlgorithm.EdmondsKarp;
    private string _preset = "developers";
    private int _left = 6;
    private int _right = 6;
    private int _density = 35;
    private int _seed = 5;
    private bool _flow;

    private MatchingInstance _instance = MatchingInstances.DevelopersAndTickets();
    private FlowNetwork _network = MatchingSolver.ToNetwork(MatchingInstances.DevelopersAndTickets());
    private IReadOnlyList<MatchingStep> _steps = [];
    private IReadOnlyList<int> _marks = [];
    private IReadOnlyList<BarDatum> _compare = [];
    private IReadOnlyList<RefLine> _refs = [];
    private int _greedy;
    private string? _shareProblem;

    private MatchingStep Step => _steps[Math.Min(_player.Index, _steps.Count - 1)];
    private MatchingStep _final => _steps[^1];

    [SupplyParameterFromQuery(Name = "i")] public string? SharedInstance { get; set; }
    [SupplyParameterFromQuery(Name = "a")] public string? SharedAlgorithm { get; set; }
    [SupplyParameterFromQuery(Name = "s")] public int? SharedStep { get; set; }
    [SupplyParameterFromQuery(Name = "v")] public string? SharedView { get; set; }
    [SupplyParameterFromQuery(Name = "m")] public string? SharedMode { get; set; }
    [SupplyParameterFromQuery(Name = "p")] public string? SharedModeState { get; set; }

    private string _mode = LabModes.Watch;
    private string? _raceState;
    private int _version;
    private string? _scaleState;

    private IReadOnlyList<string>? RaceKeys => _raceState?.Split(',', StringSplitOptions.RemoveEmptyEntries);

    // Whatever the current mode keeps in share links: racers in Race, size and seed in Scale.
    private string? ModeState()
    {
        var state = _mode switch
        {
            LabModes.Race => _raceState,
            LabModes.Scale => _scaleState,
            _ => null,
        };
        return string.IsNullOrEmpty(state) ? null : state;
    }

    private void SetMode(string mode)
    {
        _mode = mode;
        _editing = false;
        _player.Pause();
    }

    protected override void OnInitialized()
    {
        _player.Changed += OnPlayerChanged;
        _mode = LabModes.Parse(SharedMode, play: false);
        _raceState = _mode == LabModes.Race ? SharedModeState : null;
        _scaleState = _mode == LabModes.Scale ? SharedModeState : null;
        if (SharedInstance is not null && ShareState.Decode<MatchingInstance>(SharedInstance, InstanceChecks.Check, out _shareProblem) is { } shared)
        {
            _instance = shared;
            _preset = "shared";
        }

        if (Enum.TryParse<FlowAlgorithm>(SharedAlgorithm, out var algorithm) && AlgorithmOptions.Any(o => o.Value == algorithm)) _algorithm = algorithm;
        _flow = SharedView == "flow";
        Rebuild(newInstance: true);
        if (SharedStep is { } step) _player.Seek(step);
    }

    private void OnPlayerChanged() => InvokeAsync(StateHasChanged);

    private string ShareLink() => ShareState.Link(Nav, "matching",
        ("i", ShareState.Encode(_instance)), ("a", _algorithm.ToString()), ("s", _player.Index.ToString(CultureInfo.InvariantCulture)), ("v", _flow ? "flow" : null),
        ("m", _mode == LabModes.Watch ? null : _mode), ("p", ModeState()));

    private void Rebuild(bool newInstance)
    {
        _version++;
        if (newInstance)
        {
            _instance = _preset switch
            {
                "shared" or "custom" => _instance,
                "trap" => MatchingInstances.GreedyTrap(),
                "random" => MatchingInstances.Random(_left, _right, _density / 100.0, _seed),
                _ => MatchingInstances.DevelopersAndTickets(),
            };
            _network = MatchingSolver.ToNetwork(_instance);
        }

        _steps = MatchingSolver.Trace(_instance, _algorithm);
        _marks = Enumerable.Range(1, _steps.Count - 1).Where(i => _steps[i].Phase != _steps[i - 1].Phase).ToList();
        _greedy = MatchingSolver.Greedy(_instance).Count;
        var max = _final.Matched.Count;
        var possible = Math.Min(_instance.Left.Count, _instance.Right.Count);
        _compare =
        [
            new BarDatum("Greedy", _greedy, $"{_greedy}", false, _greedy == max ? "Lucky: maximum here" : $"{max - _greedy} fewer than possible"),
            new BarDatum("Max flow", max, $"{max}", true, "Maximum, proven by the minimum cut"),
        ];
        _refs = [new RefLine("Smaller side", possible)];
        _player.Load(_steps.Count);
    }

    private bool _editing;
    private (int Side, int Index)? _selected;

    private void SetEditing(ChangeEventArgs e)
    {
        _editing = e.Value is true;
        _flow = false;
        _selected = null;
    }

    // Edits become a custom example; the trace jumps to the end so the new result is visible at once.
    private void Edited(MatchingInstance instance)
    {
        if (InstanceChecks.Check(instance) is not null) return;
        _instance = instance with { Name = "Your edited example" };
        _preset = "custom";
        Rebuild(newInstance: true);
        _player.Last();
    }

    private void NodeClick((int Side, int Index) node)
    {
        if (_selected is not { } first || first.Side == node.Side)
        {
            _selected = _selected == node ? null : node;
            return;
        }

        var pair = first.Side == 0 ? new AllowedPair(first.Index, node.Index) : new AllowedPair(node.Index, first.Index);
        var pairs = _instance.Pairs.Contains(pair)
            ? _instance.Pairs.Where(p => p != pair).ToList()
            : _instance.Pairs.Append(pair).OrderBy(p => p.Left).ThenBy(p => p.Right).ToList();
        if (pairs.Count == 0) return;
        Edited(_instance with { Pairs = pairs });
    }

    private void SetAlgorithm(FlowAlgorithm algorithm)
    {
        _algorithm = algorithm;
        Rebuild(newInstance: false);
    }

    private void SetPreset(ChangeEventArgs e)
    {
        _preset = e.Value?.ToString() ?? "developers";
        Rebuild(newInstance: true);
    }

    private void SetNumber(ChangeEventArgs e, Action<int> set)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value)) return;
        set(value);
        Rebuild(newInstance: true);
    }

    private void Reroll()
    {
        _seed = Random.Shared.Next(1, 100_000);
        Rebuild(newInstance: true);
    }

    private static string Pct(int value, int min, int max) => Palette.F(100.0 * (value - min) / (max - min), "0.#") + "%";

    public void Dispose()
    {
        _player.Changed -= OnPlayerChanged;
        _player.Dispose();
    }
}
