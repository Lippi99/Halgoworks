@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="playback" role="group" aria-label="Playback">
    <div class="pb-buttons">
        <button type="button" class="pb-btn" @onclick="Player.First" disabled="@Player.AtStart" aria-label="First step" title="First step (Home)"><Icon Name="first" /></button>
        <button type="button" class="pb-btn" @onclick="Player.Prev" disabled="@Player.AtStart" aria-label="Previous step" title="Previous step (←)"><Icon Name="prev" /></button>
        <button type="button" class="pb-btn play" @onclick="Player.Toggle" disabled="@(Player.Count <= 1)" aria-label="@(Player.Playing ? "Pause" : "Play")" title="Play or pause (space)"><Icon Name="@(Player.Playing ? "pause" : "play")" /></button>
        <button type="button" class="pb-btn" @onclick="Player.Next" disabled="@Player.AtEnd" aria-label="Next step" title="Next step (→)"><Icon Name="next" /></button>
        <button type="button" class="pb-btn" @onclick="Player.Last" disabled="@Player.AtEnd" aria-label="Last step" title="Last step (End)"><Icon Name="last" /></button>
    </div>
    <div class="timeline">
        <input type="range" min="0" max="@Math.Max(0, Player.Count - 1)" value="@Player.Index" style="--pct: @Percent(Player.Index)"
               @oninput="Scrub" aria-label="Step" aria-valuetext="@($"Step {Player.Index + 1} of {Player.Count}")" />
        <div class="timeline-marks" aria-hidden="true">
            @foreach (var mark in Marks)
            {
                <span style="left: @Percent(mark)"></span>
            }
        </div>
    </div>
    <span class="pb-count">@(Player.Index + 1) / @Player.Count</span>
    <label class="field" style="grid-auto-flow: column; align-items: center; gap: 8px;">
        <span>Speed</span>
        <select @onchange="ChangeSpeed" aria-label="Playback speed">
            @foreach (var speed in Player.Speeds)
            {
                <option value="@Palette.F(speed)" selected="@(speed == Player.Speed)">@Palette.F(speed)×</option>
            }
        </select>
    </label>
    <span class="pb-hint"><kbd>Space</kbd> play <kbd>←</kbd> <kbd>→</kbd> step</span>
</div>

@code {
    [Parameter, EditorRequired] public Player Player { get; set; } = default!;

    /// <summary>Step indices where a new phase begins, drawn as ticks on the timeline.</summary>
    [Parameter] public IReadOnlyList<int> Marks { get; set; } = [];

    private IJSObjectReference? _module;
    private DotNetObjectReference<PlaybackBar>? _self;
    private int _listener;

    private string Percent(int index) =>
        Palette.F(Player.Count <= 1 ? 0 : 100.0 * index / (Player.Count - 1), "0.##") + "%";

    private void Scrub(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var index)) Player.Seek(index);
    }

    private void ChangeSpeed(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var speed)) Player.SetSpeed(speed);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/site.js");
        _self = DotNetObjectReference.Create(this);
        _listener = await _module.InvokeAsync<int>("listenKeys", _self);
    }

    [JSInvokable]
    public void OnKey(string action)
    {
        switch (action)
        {
            case "toggle": Player.Toggle(); break;
            case "next": Player.Next(); break;
            case "prev": Player.Prev(); break;
            case "first": Player.First(); break;
            case "last": Player.Last(); break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unlistenKeys", _listener);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }
}
