@using Halgoworks.Core.JobShop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="scroll-x">
    <svg @ref="_svg" class="viz" viewBox="0 0 @W @H" style="min-width: @(MinWidth)px" role="img" aria-label="@($"Gantt chart, makespan {Step.Makespan}")">
        @* Rows *@
        @for (var r = 0; r < Rows; r++)
        {
            var y = RowTop(r);
            var focus = !ByJob && Step.Machine == r;
            <g>
                <rect x="@LabelW" y="@y" width="@(W - LabelW - RightPad)" height="@RowH" fill="@(focus ? "rgba(255,178,62,0.08)" : r % 2 == 0 ? "rgba(255,255,255,0.018)" : "none")" />
                @if (focus)
                {
                    <rect x="@(LabelW - 4)" y="@(y + 4)" width="3" height="@(RowH - 8)" rx="1.5" fill="@Palette.Signal" />
                }
                <text x="@(LabelW - 12)" y="@F(y + RowH / 2.0 - (ByJob && Due(r) is not null ? 7 : 0))" text-anchor="end" dominant-baseline="central"
                      font-size="13" font-weight="600" class="@(focus ? "t-signal" : "t-1")">@RowName(r)</text>
                @if (ByJob && Due(r) is { } due)
                {
                    <g><text x="@(LabelW - 12)" y="@F(y + RowH / 2.0 + 9)" text-anchor="end" dominant-baseline="central" font-size="11" class="t-3">due @due</text></g>
                }
            </g>
        }

        @* Time axis *@
        @foreach (var tick in _ticks)
        {
            <g>
                <line x1="@F(X(tick))" x2="@F(X(tick))" y1="@AxisH" y2="@(AxisH + Rows * RowH)" stroke="@Palette.Line" stroke-opacity="0.55" stroke-width="1" />
                <text x="@F(X(tick))" y="@(AxisH - 10)" text-anchor="middle" font-size="12" class="t-3 tabular">@tick</text>
            </g>
        }

        @* Due-date markers in the job view *@
        @if (ByJob)
        {
            @for (var j = 0; j < Rows; j++)
            {
                if (Due(j) is not { } due) continue;
                var y = RowTop(j);
                <line x1="@F(X(due))" x2="@F(X(due))" y1="@(y + 3)" y2="@(y + RowH - 3)" stroke="@Palette.Text2" stroke-width="2" />
            }
        }

        @* Scheduled operations *@
        @foreach (var op in Step.Scheduled)
        {
            var row = ByJob ? op.Job : op.Machine;
            var x = X(op.Start);
            var w = Math.Max(1, X(op.End) - x - 1.5);
            var y = RowTop(row) + (RowH - BarH) / 2.0;
            var isFocus = Step.Focus is { } f && f.Job == op.Job && f.Index == op.Index;
            var critical = _critical.Contains((op.Job, op.Index));
            var swapped = Step.Swapped.Any(s => s.Job == op.Job && s.Index == op.Index);
            var label = ByJob ? MachineShort(op.Machine) : JobShopSolver.Label(op.Job, op.Index);
            var dragged = _drag is { } d && d.Op.Job == op.Job && d.Op.Index == op.Index && d.X is not null;
            var selected = Selected is { } sel && sel.Job == op.Job && sel.Index == op.Index;
            <g opacity="@(dragged ? "0.35" : "1")" style="@(Draggable ? "cursor: grab; touch-action: none" : null)"
               data-drag="@(Draggable && !ByJob ? $"{op.Job}.{op.Index}" : null)" @onclick="() => SelectOp(new OpRef(op.Job, op.Index))">
                <rect x="@F(x)" y="@F(y)" width="@F(w)" height="@BarH" rx="4" fill="@Palette.Slot(op.Job)"
                      stroke="@(selected ? Palette.Text1 : isFocus || critical || swapped ? Palette.Signal : "none")" stroke-width="@(isFocus || selected ? 3 : 2)"
                      stroke-dasharray="@(swapped && !isFocus ? "5 3" : null)" class="@(isFocus ? "glow" : null)">
                    <title>@($"{JobShopSolver.Label(op.Job, op.Index)} on {Instance.Machines[op.Machine]}: {op.Start}–{op.End}")</title>
                </rect>
                @if (w >= TextWidth(label) + 8)
                {
                    <g><text x="@F(x + w / 2)" y="@F(y + BarH / 2.0)" text-anchor="middle" dominant-baseline="central" font-size="12" font-weight="600" fill="#fff">@label</text></g>
                }
                else if (w >= 16 && !ByJob)
                {
                    <g><text x="@F(x + w / 2)" y="@F(y + BarH / 2.0)" text-anchor="middle" dominant-baseline="central" font-size="11" font-weight="600" fill="#fff">@(op.Job + 1)</text></g>
                }
            </g>
        }

        @if (_drag is { X: { } dragX } drag && Step.Scheduled.FirstOrDefault(o => o.Job == drag.Op.Job && o.Index == drag.Op.Index) is { } moving)
        {
            var row = ByJob ? moving.Job : moving.Machine;
            var w = Math.Max(1, X(moving.End) - X(moving.Start) - 1.5);
            var left = Math.Clamp(dragX - drag.Grab, LabelW, W - RightPad - w);
            <g pointer-events="none">
                <rect x="@F(left)" y="@F(RowTop(row) + (RowH - BarH) / 2.0 - 3)" width="@F(w)" height="@(BarH + 6)" rx="5" fill="@Palette.Slot(moving.Job)" fill-opacity="0.85"
                      stroke="@Palette.Signal" stroke-width="2.5" class="glow" />
                <line x1="@F(InsertX(moving, left + w / 2))" x2="@F(InsertX(moving, left + w / 2))" y1="@RowTop(row)" y2="@(RowTop(row) + RowH)" stroke="@Palette.Signal" stroke-width="3" />
            </g>
        }

        @* Critical path connectors *@
        @for (var k = 1; k < _criticalOps.Count; k++)
        {
            var a = _criticalOps[k - 1];
            var b = _criticalOps[k];
            var ra = ByJob ? a.Job : a.Machine;
            var rb = ByJob ? b.Job : b.Machine;
            if (ra == rb) continue;
            <line x1="@F(X(a.End))" x2="@F(X(b.Start))" y1="@F(RowTop(ra) + RowH / 2.0)" y2="@F(RowTop(rb) + RowH / 2.0)" stroke="@Palette.Signal" stroke-width="1.6" />
        }

        @* Waiting operations at their earliest start *@
        @foreach (var c in Step.Candidates)
        {
            var row = ByJob ? c.Job : c.Machine;
            var (lane, lanes) = _lanes.GetValueOrDefault((c.Job, c.Index), (0, 1));
            var laneH = (double)BarH / lanes;
            var x = X(c.Start);
            var w = Math.Max(1, X(c.End) - x - 1.5);
            var y = RowTop(row) + (RowH - BarH) / 2.0 + lane * laneH;
            var stroke = c.Chosen || c.Conflict ? Palette.Signal : Palette.Slot(c.Job);
            <g>
                <rect x="@F(x)" y="@F(y)" width="@F(w)" height="@F(Math.Max(3, laneH - 1.5))" rx="@(lanes > 2 ? 2 : 4)" fill="@Palette.Slot(c.Job)" fill-opacity="@(c.Chosen ? "0.55" : "0.16")"
                      stroke="@stroke" stroke-width="@(c.Chosen ? 2.5 : 1.5)" stroke-dasharray="@(c.Chosen ? null : "5 3")" class="@(c.Chosen ? "glow" : null)">
                    <title>@($"{JobShopSolver.Label(c.Job, c.Index)} could run {c.Start}–{c.End}")</title>
                </rect>
                @if (laneH >= 13 && w >= TextWidth(JobShopSolver.Label(c.Job, c.Index)) + 8)
                {
                    <g><text x="@F(x + w / 2)" y="@F(y + laneH / 2 - 0.5)" text-anchor="middle" dominant-baseline="central" font-size="@(laneH >= 20 ? 12 : 10.5)" font-weight="600" class="t-1">@JobShopSolver.Label(c.Job, c.Index)</text></g>
                }
            </g>
        }

        @if (Step.Cut is { } cut)
        {
            <g>
                <line x1="@F(X(cut))" x2="@F(X(cut))" y1="@(AxisH - 4)" y2="@(AxisH + Rows * RowH)" stroke="@Palette.Signal" stroke-width="1.6" stroke-dasharray="4 3" />
                <rect x="@F(X(cut) - 22)" y="2" width="44" height="18" rx="9" fill="@Palette.Signal" />
                <text x="@F(X(cut))" y="11" text-anchor="middle" dominant-baseline="central" font-size="11" font-weight="700" fill="@Palette.Ink0">t = @cut</text>
            </g>
        }
        else if (Step.Makespan > 0)
        {
            <g>
                <line x1="@F(X(Step.Makespan))" x2="@F(X(Step.Makespan))" y1="@(AxisH - 4)" y2="@(AxisH + Rows * RowH)" stroke="@Palette.Text1" stroke-width="1.4" />
                <text x="@F(X(Step.Makespan) + 6)" y="@(AxisH + Rows * RowH + 14)" font-size="12" font-weight="600" class="t-1 tabular">makespan @Step.Makespan</text>
            </g>
        }
    </svg>
</div>

@code {
    [Parameter, EditorRequired] public JobShopInstance Instance { get; set; } = default!;
    [Parameter, EditorRequired] public JobShopStep Step { get; set; } = default!;
    [Parameter] public bool ByJob { get; set; }

    /// <summary>Below this width the chart scrolls sideways instead of shrinking further.</summary>
    [Parameter] public int MinWidth { get; set; } = 640;

    /// <summary>Right end of the time axis, fixed for the whole trace so bars don't jump around.</summary>
    [Parameter] public int Horizon { get; set; } = 10;

    /// <summary>Play mode: bars can be dragged along their machine row (machine view only).</summary>
    [Parameter] public bool Draggable { get; set; }

    /// <summary>A bar was dropped: the operation and the time under the middle of where it landed.</summary>
    [Parameter] public EventCallback<(OpRef Op, double Time)> OnDrop { get; set; }

    [Parameter] public EventCallback<OpRef> OnSelect { get; set; }
    [Parameter] public OpRef? Selected { get; set; }

    private ElementReference _svg;
    private IJSObjectReference? _dragModule;
    private DotNetObjectReference<GanttChart>? _self;
    private (OpRef Op, double Grab, double? X)? _drag;

    private double TimeAt(double x) => (x - LabelW) / (W - LabelW - RightPad) * Horizon;

    // Where the dragged bar would slot in among the other operations on its machine, for the insertion marker.
    private double InsertX(ScheduledOp moving, double centerX)
    {
        var others = Step.Scheduled.Where(o => o.Machine == moving.Machine && (o.Job != moving.Job || o.Index != moving.Index)).OrderBy(o => o.Start).ToList();
        var t = TimeAt(centerX);
        var before = others.Where(o => (o.Start + o.End) / 2.0 < t).ToList();
        return before.Count == 0 ? X(others.Count == 0 ? 0 : Math.Min(others[0].Start, moving.Start)) - 2 : X(before[^1].End) + 0.5;
    }

    private async Task SelectOp(OpRef op)
    {
        if (Draggable) await OnSelect.InvokeAsync(op);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _dragModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/drag.js");
            _self = DotNetObjectReference.Create(this);
            await _dragModule.InvokeVoidAsync("attach", _svg, _self);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public void OnDragStart(string key, double x, double y)
    {
        if (!Draggable || ByJob) return;
        var parts = key.Split('.');
        if (parts.Length != 2 || !int.TryParse(parts[0], CultureInfo.InvariantCulture, out var job) || !int.TryParse(parts[1], CultureInfo.InvariantCulture, out var index)) return;
        if (Step.Scheduled.FirstOrDefault(o => o.Job == job && o.Index == index) is not { } op) return;
        _drag = (new OpRef(job, index), x - X(op.Start), null);
    }

    [JSInvokable]
    public void OnDragMove(string key, double x, double y)
    {
        if (_drag is not { } d) return;
        _drag = d with { X = x };
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnDragEnd(string key, double x, double y, bool moved)
    {
        if (_drag is not { } d) return;
        _drag = null;
        var moving = Step.Scheduled.First(o => o.Job == d.Op.Job && o.Index == d.Op.Index);
        var width = X(moving.End) - X(moving.Start);
        if (moved) await OnDrop.InvokeAsync((d.Op, TimeAt(x - d.Grab + width / 2)));
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_dragModule is not null)
        {
            try
            {
                await _dragModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }

    private const int W = 1000;
    private const int LabelW = 92;
    private const int RightPad = 20;
    private const int AxisH = 30;
    private const int RowH = 44;
    private const int BarH = 30;

    private List<int> _ticks = [];
    private Dictionary<(int, int), (int Lane, int Lanes)> _lanes = [];
    private HashSet<(int, int)> _critical = [];
    private List<ScheduledOp> _criticalOps = [];

    private int Rows => ByJob ? Instance.Jobs.Count : Instance.Machines.Count;
    private int H => AxisH + Rows * RowH + 22;

    protected override void OnParametersSet()
    {
        var step = Horizon <= 30 ? 2 : Horizon <= 60 ? 5 : Horizon <= 150 ? 10 : 20;
        _ticks = Enumerable.Range(0, Horizon / step + 1).Select(i => i * step).ToList();
        _critical = Step.Critical.Select(c => (c.Job, c.Index)).ToHashSet();
        // Several operations can wait for the same machine at once; give each its own thin lane so they don't pile up.
        _lanes = Step.Candidates
            .GroupBy(c => ByJob ? c.Job : c.Machine)
            .SelectMany(g => g.OrderBy(c => c.Start).ThenBy(c => c.Job).Select((c, i) => (Key: (c.Job, c.Index), Lane: i, Lanes: g.Count())))
            .ToDictionary(x => x.Key, x => (x.Lane, x.Lanes));
        var byRef = Step.Scheduled.ToDictionary(o => (o.Job, o.Index));
        _criticalOps = Step.Critical.Where(c => byRef.ContainsKey((c.Job, c.Index))).Select(c => byRef[(c.Job, c.Index)]).ToList();
    }

    private double X(int t) => LabelW + (double)t / Horizon * (W - LabelW - RightPad);

    private static double RowTop(int r) => AxisH + r * RowH;

    private string RowName(int r) => ByJob ? Instance.Jobs[r].Name : Instance.Machines[r];

    private int? Due(int job) => Instance.Jobs[job].Due;

    private string MachineShort(int m) => Instance.Machines[m];

    private static double TextWidth(string s) => s.Length * 7.2;

    private static string F(double v) => Palette.F(v, "0.#");
}
