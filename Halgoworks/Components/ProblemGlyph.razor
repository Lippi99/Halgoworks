@* Small hand-drawn previews for the problem index. Decorative: the row text says the same thing. *@

<svg class="problem-glyph" viewBox="0 0 112 80" aria-hidden="true">
    @switch (Slug)
    {
        case "routing":
            <path d="M56 42 L30 22 L18 40 L34 58 Z" fill="none" stroke="@Palette.Series[0]" stroke-width="2.2" stroke-linejoin="round" />
            <path d="M56 42 L78 18 L94 34 L84 60 Z" fill="none" stroke="@Palette.Series[1]" stroke-width="2.2" stroke-linejoin="round" />
            <circle cx="30" cy="22" r="4" fill="@Palette.Series[0]" /><circle cx="18" cy="40" r="3.5" fill="@Palette.Series[0]" /><circle cx="34" cy="58" r="4.5" fill="@Palette.Series[0]" />
            <circle cx="78" cy="18" r="4" fill="@Palette.Series[1]" /><circle cx="94" cy="34" r="5" fill="@Palette.Series[1]" /><circle cx="84" cy="60" r="3.5" fill="@Palette.Series[1]" />
            <rect x="50" y="36" width="12" height="12" rx="2.5" fill="#d8e1ee" />
            break;
        case "knapsack":
            for (var r = 0; r < 4; r++)
            {
                for (var c = 0; c < 7; c++)
                {
                    var v = Math.Min(1, r * c / 14.0 + (r > 0 ? 0.1 : 0));
                    var on = r == 3 && c == 6;
                    <rect x="@(14 + c * 12.5)" y="@(12 + r * 14.5)" width="10.5" height="12.5" rx="2" fill="@(on ? Palette.Signal : Palette.RampAt(v))" />
                }
            }
            break;
        case "job-shop":
            <rect x="14" y="16" width="26" height="12" rx="2.5" fill="@Palette.Series[0]" /><rect x="42" y="16" width="18" height="12" rx="2.5" fill="@Palette.Series[2]" /><rect x="66" y="16" width="30" height="12" rx="2.5" fill="@Palette.Series[1]" />
            <rect x="14" y="34" width="14" height="12" rx="2.5" fill="@Palette.Series[2]" /><rect x="40" y="34" width="28" height="12" rx="2.5" fill="@Palette.Series[1]" /><rect x="70" y="34" width="16" height="12" rx="2.5" fill="@Palette.Series[0]" />
            <rect x="28" y="52" width="22" height="12" rx="2.5" fill="@Palette.Series[1]" /><rect x="52" y="52" width="20" height="12" rx="2.5" fill="@Palette.Series[0]" fill-opacity="0.25" stroke="@Palette.Signal" stroke-width="1.5" stroke-dasharray="3 2" />
            break;
        case "bin-packing":
            for (var b = 0; b < 3; b++)
            {
                var x = 18 + b * 28;
                <rect x="@x" y="12" width="22" height="56" rx="3" fill="none" stroke="@Palette.Line" stroke-width="1.5" />
            }
            <rect x="20" y="40" width="18" height="26" rx="2" fill="@Palette.SizeClass[2]" /><rect x="20" y="26" width="18" height="12" rx="2" fill="@Palette.SizeClass[0]" />
            <rect x="48" y="36" width="18" height="30" rx="2" fill="@Palette.SizeClass[2]" /><rect x="48" y="20" width="18" height="14" rx="2" fill="@Palette.SizeClass[1]" />
            <rect x="76" y="46" width="18" height="20" rx="2" fill="@Palette.SizeClass[1]" /><rect x="76" y="30" width="18" height="12" rx="2" fill="@Palette.Signal" />
            break;
        case "matching":
            for (var i = 0; i < 4; i++)
            {
                <circle cx="30" cy="@(14 + i * 17)" r="4.5" fill="@Palette.Ink2" stroke="@Palette.Text2" stroke-width="1.5" />
                <circle cx="82" cy="@(14 + i * 17)" r="4.5" fill="@Palette.Ink2" stroke="@Palette.Text2" stroke-width="1.5" />
            }
            <path d="M34 14L78 31M34 48L78 65M34 65L78 48" stroke="@Palette.Line" stroke-width="1.5" />
            <path d="M34 14L78 14M34 31L78 48M34 65L78 65" stroke="@Palette.Series[0]" stroke-width="3" stroke-linecap="round" />
            <path d="M34 48L78 31" stroke="@Palette.Signal" stroke-width="3" stroke-linecap="round" />
            break;
        default:
            <path d="M20 40 L50 20 L86 26 L96 40 M20 40 L50 60 L86 54 L96 40 M50 20 L50 60" fill="none" stroke="@Palette.Line" stroke-width="5" stroke-linecap="round" />
            <path d="M20 40 L50 20 L86 26 L96 40" fill="none" stroke="@Palette.Series[0]" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M20 40 L50 60 L86 54 L96 40" fill="none" stroke="@Palette.Signal" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="20" cy="40" r="6" fill="@Palette.Ink2" stroke="@Palette.Text2" stroke-width="1.5" />
            <circle cx="50" cy="20" r="4.5" fill="@Palette.Ink2" stroke="@Palette.Text3" stroke-width="1.5" />
            <circle cx="50" cy="60" r="4.5" fill="@Palette.Ink2" stroke="@Palette.Text3" stroke-width="1.5" />
            <circle cx="86" cy="26" r="4.5" fill="@Palette.Ink2" stroke="@Palette.Text3" stroke-width="1.5" />
            <circle cx="86" cy="54" r="4.5" fill="@Palette.Ink2" stroke="@Palette.Text3" stroke-width="1.5" />
            <circle cx="96" cy="40" r="6" fill="@Palette.Ink2" stroke="@Palette.Text2" stroke-width="1.5" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
}
