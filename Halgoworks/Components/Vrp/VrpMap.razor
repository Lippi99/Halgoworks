@using Halgoworks.Core.Vrp
@implements IAsyncDisposable
@inject IJSRuntime JS

<svg @ref="_svg" class="viz @(Editable ? "editing" : null)" viewBox="0 0 @Size @Size" style="max-width: 640px; margin: 0 auto; @(Editable ? "cursor: crosshair" : "")" role="img" @onclick="MapClick"
     aria-label="@($"Map of {Instance.Customers.Count} customers and {Step.Routes.Count} routes")">
    <defs>
        @for (var i = 0; i < Palette.Series.Length; i++)
        {
            <marker id="@($"vrp-arrow-{i}")" viewBox="0 0 10 10" refX="5" refY="5" markerUnits="userSpaceOnUse" markerWidth="9" markerHeight="9" orient="auto">
                <path d="M1 1L9 5L1 9z" fill="@Palette.Series[i]" />
            </marker>
        }
        <marker id="vrp-arrow-other" viewBox="0 0 10 10" refX="5" refY="5" markerUnits="userSpaceOnUse" markerWidth="9" markerHeight="9" orient="auto">
            <path d="M1 1L9 5L1 9z" fill="@Palette.Other" />
        </marker>
        <clipPath id="vrp-clip">
            <rect x="@Margin" y="@Margin" width="@(Size - 2 * Margin)" height="@(Size - 2 * Margin)" rx="6" />
        </clipPath>
    </defs>

    <rect x="@Margin" y="@Margin" width="@(Size - 2 * Margin)" height="@(Size - 2 * Margin)" rx="6" fill="@Palette.Ink0" stroke="@Palette.Line"
 />
    @for (var k = 1; k < Extent; k++)
    {
        var major = k % 5 == 0;
        <line x1="@F(P(k))" x2="@F(P(k))" y1="@Margin" y2="@(Size - Margin)" stroke="@(major ? "#22365a" : "#18283f")" stroke-width="1" />
        <line y1="@F(P(k))" y2="@F(P(k))" x1="@Margin" x2="@(Size - Margin)" stroke="@(major ? "#22365a" : "#18283f")" stroke-width="1" />
    }
    <text x="@(Size - Margin - 4)" y="@(Size - Margin - 6)" text-anchor="end" font-size="11" class="t-3">1 square = 1 km</text>

    @if (Step.Sweep is { } angle)
    {
        var (dx, dy) = Pos(0);
        <line x1="@F(P(dx))" y1="@F(P(dy))" x2="@F(P(dx) + Math.Cos(angle) * 900)" y2="@F(P(dy) + Math.Sin(angle) * 900)"
              stroke="@Palette.Signal" stroke-width="2" clip-path="url(#vrp-clip)" />
    }

    @for (var r = 0; r < Step.Routes.Count; r++)
    {
        var route = Step.Routes[r];
        var slot = Step.Colors.Count > r ? Step.Colors[r] : r;
        var color = slot < 0 ? Palette.Other : Palette.Slot(slot);
        var neutral = slot < 0;
        var active = Step.Active is null || Step.Active == r;
        <path d="@RoutePath(route)" fill="none" stroke="@color" stroke-width="@(neutral ? 1.2 : Compact ? 1.8 : active ? 3 : 2.2)" stroke-linejoin="round" stroke-linecap="round"
              opacity="@(neutral ? "0.55" : active ? "1" : "0.4")"
              marker-mid="@(neutral || Compact ? null : $"url(#vrp-arrow-{(slot < Palette.Series.Length ? slot.ToString() : "other")})")" />
    }

    @foreach (var edge in Step.Removed)
    {
        var (ax, ay) = Pos(edge[0]);
        var (bx, by) = Pos(edge[1]);
        <line x1="@F(P(ax))" y1="@F(P(ay))" x2="@F(P(bx))" y2="@F(P(by))" stroke="@Palette.BadText" stroke-width="2.5" stroke-dasharray="6 4" />
    }

    @foreach (var edge in Step.Added)
    {
        var (ax, ay) = Pos(edge[0]);
        var (bx, by) = Pos(edge[1]);
        <line x1="@F(P(ax))" y1="@F(P(ay))" x2="@F(P(bx))" y2="@F(P(by))" stroke="@Palette.Signal" stroke-width="3" class="glow" />
    }

    @if (Step.Link is { Length: 2 } link)
    {
        var (ax, ay) = Pos(link[0]);
        var (bx, by) = Pos(link[1]);
        var bad = Step.LinkOk == false;
        <line x1="@F(P(ax))" y1="@F(P(ay))" x2="@F(P(bx))" y2="@F(P(by))" stroke="@(bad ? Palette.BadText : Palette.Signal)" stroke-width="2.5"
              stroke-dasharray="7 5" class="@(bad ? null : "glow")" />
        @if (bad)
        {
            <g>
                <circle cx="@F((P(ax) + P(bx)) / 2)" cy="@F((P(ay) + P(by)) / 2)" r="10" fill="@Palette.Ink0" stroke="@Palette.BadText" stroke-width="1.5" />
                <text x="@F((P(ax) + P(bx)) / 2)" y="@F((P(ay) + P(by)) / 2)" text-anchor="middle" dominant-baseline="central" font-size="13" font-weight="700" fill="@Palette.BadText">✗</text>
            </g>
        }
    }

    @if (Step.Final && !Reduced && !Compact)
    {
        @for (var r = 0; r < Step.Routes.Count; r++)
        {
            var route = Step.Routes[r];
            var slot = Step.Colors.Count > r ? Step.Colors[r] : r;
            var length = VrpSolver.Evaluate(Instance, route).Distance;
            <circle r="6" fill="@Palette.Ink0" stroke="@Palette.Slot(slot)" stroke-width="3">
                <animateMotion dur="@($"{Palette.F(Math.Max(3, length * 0.35), "0.#")}s")" repeatCount="indefinite" path="@RoutePath(route)" />
            </circle>
        }
    }

    @foreach (var c in Instance.Customers)
    {
        var (x, y) = _dragId == c.Id && _dragAt is { } at ? (P(at.X), P(at.Y)) : (P(c.X), P(c.Y));
        var radius = Compact ? 2.5 + c.Demand * 0.3 : 6 + c.Demand * 0.8;
        var routeIndex = RouteOf(c.Id);
        var slot = routeIndex < 0 ? -2 : Step.Colors.Count > routeIndex ? Step.Colors[routeIndex] : routeIndex;
        var fill = slot == -2 ? Palette.Ink2 : slot < 0 ? "#3b4a63" : Palette.Slot(slot);
        var focus = Step.Focus.Contains(c.Id);
        <g>
            @if (focus)
            {
                <circle cx="@F(x)" cy="@F(y)" r="@F(radius + 5)" fill="none" stroke="@Palette.Signal" stroke-width="2.5" class="glow" />
            }
            @if (Selected == c.Id)
            {
                <circle cx="@F(x)" cy="@F(y)" r="@F(radius + 5)" fill="none" stroke="@Palette.Text1" stroke-width="2" stroke-dasharray="3 3" />
            }
            <circle cx="@F(x)" cy="@F(y)" r="@F(radius)" fill="@fill" stroke="@(slot == -2 ? Palette.Text3 : Palette.Ink0)" stroke-width="@(Compact ? 0.8 : slot == -2 ? 1.2 : 2)"
                    style="@(Interactive ? (Editable ? "cursor: grab; touch-action: none" : "cursor: pointer") : null)"
                    @onclick="() => CustomerClick(c.Id)" @onclick:stopPropagation="true" data-drag="@(Editable ? c.Id.ToString(CultureInfo.InvariantCulture) : null)">
                <title>@Describe(c)</title>
            </circle>
            @if (!Compact)
            {
                <g><text x="@F(x)" y="@F(y)" text-anchor="middle" dominant-baseline="central" font-size="9.5" font-weight="700" fill="#fff" pointer-events="none">@c.Id</text></g>
            }
        </g>
    }

    @{
        var (depotX, depotY) = (P(Instance.DepotX), P(Instance.DepotY));
    }
    <g>
        <rect x="@F(depotX - 13)" y="@F(depotY - 13)" width="26" height="26" rx="5" fill="#d8e1ee" stroke="@Palette.Ink0" stroke-width="2" />
        <path d="@($"M{F(depotX - 7)} {F(depotY + 6)}V{F(depotY - 2)}L{F(depotX)} {F(depotY - 8)}L{F(depotX + 7)} {F(depotY - 2)}V{F(depotY + 6)}Z")" fill="@Palette.Ink0" />
        <text x="@F(depotX)" y="@F(depotY + 27)" text-anchor="middle" font-size="12" font-weight="600" class="t-1">Depot</text>
    </g>
</svg>

@code {
    [Parameter, EditorRequired] public VrpInstance Instance { get; set; } = default!;
    [Parameter, EditorRequired] public VrpStep Step { get; set; } = default!;
    [Parameter] public bool Reduced { get; set; }

    /// <summary>Small dots, no labels or arrows: for instances with a hundred or more customers.</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Play mode: a customer was clicked.</summary>
    [Parameter] public EventCallback<int> OnCustomerClick { get; set; }

    /// <summary>Edit mode: click empty map to add, drag to move, click to select.</summary>
    [Parameter] public bool Editable { get; set; }

    [Parameter] public EventCallback<(double X, double Y)> OnMapClick { get; set; }
    [Parameter] public EventCallback<(int Id, double X, double Y)> OnCustomerMoved { get; set; }
    [Parameter] public int? Selected { get; set; }

    private ElementReference _svg;
    private IJSObjectReference? _drag;
    private DotNetObjectReference<VrpMap>? _self;
    private int? _dragId;
    private (double X, double Y)? _dragAt;

    private bool Interactive => Editable || OnCustomerClick.HasDelegate;

    private double ToKm(double px) => Math.Clamp((px - Margin) / Km, 0.2, Extent - 0.2);

    private async Task CustomerClick(int id)
    {
        if (OnCustomerClick.HasDelegate) await OnCustomerClick.InvokeAsync(id);
    }

    private async Task MapClick(MouseEventArgs e)
    {
        if (!Editable) return;
        _drag ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/drag.js");
        var point = await _drag.InvokeAsync<double[]>("svgPoint", _svg, e.ClientX, e.ClientY);
        await OnMapClick.InvokeAsync((Math.Round(ToKm(point[0]), 2), Math.Round(ToKm(point[1]), 2)));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _drag = await JS.InvokeAsync<IJSObjectReference>("import", "./js/drag.js");
            _self = DotNetObjectReference.Create(this);
            await _drag.InvokeVoidAsync("attach", _svg, _self);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public void OnDragStart(string key, double x, double y)
    {
        if (Editable && int.TryParse(key, CultureInfo.InvariantCulture, out var id)) _dragId = id;
    }

    [JSInvokable]
    public void OnDragMove(string key, double x, double y)
    {
        if (_dragId is null) return;
        _dragAt = (ToKm(x), ToKm(y));
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnDragEnd(string key, double x, double y, bool moved)
    {
        var id = _dragId;
        _dragId = null;
        _dragAt = null;
        if (id is not { } customer) return;
        if (moved) await OnCustomerMoved.InvokeAsync((customer, Math.Round(ToKm(x), 2), Math.Round(ToKm(y), 2)));
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_drag is not null)
        {
            try
            {
                await _drag.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }

    private const int Size = 600;
    private const int Margin = 20;
    // Generated maps are 20 km across; real-city maps are a smaller box with the depot in the middle.
    private double Extent => Instance.Geo is null ? 20 : Math.Max(1, Math.Round(2 * Math.Max(Instance.DepotX, Instance.DepotY)));

    private double Km => (Size - 2.0 * Margin) / Extent;

    private double P(double km) => Margin + km * Km;

    private (double X, double Y) Pos(int node) => Instance.Pos(node);

    private int RouteOf(int customer)
    {
        for (var r = 0; r < Step.Routes.Count; r++)
            if (Array.IndexOf(Step.Routes[r], customer) >= 0) return r;
        return -1;
    }

    // Depot → stops → depot, with an extra vertex at the middle of each leg so marker-mid can draw a direction arrow there.
    private string RoutePath(int[] route)
    {
        var nodes = new List<int> { 0 };
        nodes.AddRange(route);
        nodes.Add(0);
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < nodes.Count; i++)
        {
            var (x, y) = Pos(nodes[i]);
            if (i == 0)
            {
                sb.Append($"M{F(P(x))} {F(P(y))}");
                continue;
            }

            var (px, py) = Pos(nodes[i - 1]);
            sb.Append($"L{F(P((px + x) / 2))} {F(P((py + y) / 2))}L{F(P(x))} {F(P(y))}");
        }

        return sb.ToString();
    }

    private string Describe(Customer c) => Instance.UseDeadlines
        ? $"C{c.Id}: demand {c.Demand}, deliver by {VrpInstance.Clock(c.Deadline)}"
        : $"C{c.Id}: demand {c.Demand}";

    private static string F(double v) => Palette.F(v, "0.#");
}
