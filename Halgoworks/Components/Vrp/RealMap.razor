@using Halgoworks.Core.Vrp
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="realmap" @ref="_element" role="application" aria-label="@($"Street map of {Instance.Name} with {Instance.Customers.Count} customers. Click the map to add a customer.")"></div>

@code {
    [Parameter, EditorRequired] public VrpInstance Instance { get; set; } = default!;
    [Parameter, EditorRequired] public VrpStep Step { get; set; } = default!;

    /// <summary>Road shapes for finished routes, keyed by <see cref="ShapeKey"/>; routes without one are drawn as straight lines.</summary>
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<double[]>> Shapes { get; set; } = new Dictionary<string, IReadOnlyList<double[]>>();

    [Parameter] public EventCallback<(double Lat, double Lon)> OnMapClick { get; set; }

    public static string ShapeKey(IReadOnlyList<int> route) => "0-" + string.Join("-", route) + "-0";

    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _map;
    private DotNetObjectReference<RealMap>? _self;
    private (VrpInstance?, VrpStep?, int) _drawn;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/realmap.js");
                _self = DotNetObjectReference.Create(this);
                _map = await _module.InvokeAsync<IJSObjectReference>("create", _element, _self);
            }

            if (_map is null || _drawn == (Instance, Step, Shapes.Count)) return;
            _drawn = (Instance, Step, Shapes.Count);
            await _map.InvokeVoidAsync("update", State());
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public Task MapClicked(double lat, double lon) => OnMapClick.InvokeAsync((lat, lon));

    private double[] At(int node)
    {
        var (lat, lon) = Instance.LatLon(node);
        return [lat, lon];
    }

    private object State()
    {
        var lines = new List<object>();
        var routeColor = new Dictionary<int, string>();
        for (var r = 0; r < Step.Routes.Count; r++)
        {
            var route = Step.Routes[r];
            var slot = Step.Colors.Count > r ? Step.Colors[r] : r;
            var neutral = slot < 0;
            var color = neutral ? Palette.Other : Palette.Slot(slot);
            var active = Step.Active is null || Step.Active == r;
            foreach (var c in route) routeColor[c] = color;
            var points = Step.Final && Shapes.TryGetValue(ShapeKey(route), out var road)
                ? road
                : route.Prepend(0).Append(0).Select(At).ToList();
            lines.Add(new { points, color, weight = neutral ? 1.5 : active ? 4 : 2.5, opacity = neutral ? 0.5 : active ? 0.95 : 0.45 });
        }

        foreach (var edge in Step.Removed)
            lines.Add(new { points = new[] { At(edge[0]), At(edge[1]) }, color = Palette.BadText, weight = 3, opacity = 1, dash = "6 6" });
        foreach (var edge in Step.Added)
            lines.Add(new { points = new[] { At(edge[0]), At(edge[1]) }, color = Palette.Signal, weight = 4, opacity = 1 });
        if (Step.Link is { Length: 2 } link)
            lines.Add(new { points = new[] { At(link[0]), At(link[1]) }, color = Step.LinkOk == false ? Palette.BadText : Palette.Signal, weight = 3, opacity = 1, dash = "8 6" });

        return new
        {
            fitKey = $"{Instance.Name}|{Instance.Customers.Count}|{Instance.Geo?[0]}|{Instance.Geo?[1]}",
            depot = At(0),
            customers = Instance.Customers.Select(c => new
            {
                lat = At(c.Id)[0],
                lon = At(c.Id)[1],
                radius = 5 + c.Demand * 0.7,
                color = routeColor.GetValueOrDefault(c.Id, Palette.Muted),
                focus = Step.Focus.Contains(c.Id),
                title = $"C{c.Id}: demand {c.Demand}",
            }),
            lines,
        };
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_map is not null)
            {
                await _map.InvokeVoidAsync("dispose");
                await _map.DisposeAsync();
            }

            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }
}
